{
  "id": "wm-notice-radar",
  "name": "公告搜索",
  "version": "1.2.0",
  "tier": 1,
  "visibility": "opt_in",
  "description": "查询 A 股/港股公司公告，或按类别/减持回购信号扫描。用户问公告、业绩预告、减持回购、全市场公告汇总时使用。仅交易所公告，不含财经媒体/舆情新闻。美股暂不支持（返回 UNSUPPORTED_MARKET）。",
  "inputs_schema": {
    "type": "object",
    "properties": {
      "symbol": {
        "type": "string",
        "description": "单票代码；6 位 A 股 / 1–5 位港股自动分表；美股返回 UNSUPPORTED_MARKET"
      },
      "mode": {
        "type": "string",
        "enum": [
          "list",
          "category",
          "signal",
          "digest"
        ],
        "default": "list"
      },
      "category": {
        "type": "string",
        "description": "mode=category 时：forecast/buyback/reduction；watch|worth 等价 digest"
      },
      "signal": {
        "type": "string",
        "enum": [
          "reduction",
          "buyback"
        ],
        "description": "mode=signal 时；无 symbol 则降级为全市场 category"
      },
      "window": {
        "type": "string",
        "default": "1m"
      },
      "limit": {
        "type": "integer",
        "default": 20,
        "maximum": 100
      },
      "market": {
        "type": "string",
        "enum": [
          "cn",
          "hk"
        ],
        "description": "全市场 digest/category 扫描市场；默认 cn。单票由 symbol 形态推断，可省略"
      }
    }
  },
  "runtime": {
    "mode": "skill_run",
    "script_ref": "scr_wm_notice_radar",
    "path": "xs/skillhub/wm_notice_radar.xs"
  },
  "required_scopes": [
    "analysis:skills:run"
  ],
  "depends_libs": [
    "sys/notice"
  ],
  "icon": "公",
  "category": "资讯与公告",
  "author": "赢麻了官方",
  "official": true,
  "summary": "查公司公告与大事线索（减持、回购等），快速抓住披露要点。",
  "sample_prompts": [
    "某某公司最近有什么重要公告？",
    "关注列表里谁有大事？",
    "帮我扫一眼最近的风险类公告。"
  ],
  "expertise_tags": [
    "公告",
    "大事"
  ],
  "outputs_schema": {
    "type": "object",
    "x-envelope": "skills_run",
    "description": "Body = data.result (XS return). HTTP prefix: data.result.",
    "x-primary_path": "items",
    "properties": {
      "items": {
        "type": "array"
      },
      "by_category": {
        "type": "object",
        "description": "mode=digest 时按类别分组的公告列表"
      },
      "resolved_mode": {
        "type": "string",
        "description": "实际执行模式（signal 无标的时可能为 category）"
      },
      "note": {
        "type": "string"
      }
    }
  }
}
