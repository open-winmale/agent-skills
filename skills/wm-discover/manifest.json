{
  "id": "wm-discover",
  "name": "统一发现",
  "version": "1.4.1",
  "tier": 0,
  "visibility": "public",
  "description": "用自然语言找公司/证券代码、行业与指数、SkillHub 技能、指标定义、XS 函数(vfunc，含 example_call_xs/call_spec 与域库 kline|notice|filings…；稳定域库已随 init 预载)/测试示例、选股字段。不确定 wm-* 时先 discover（domain=skill），再 wm.sh run。",
  "inputs_schema": {
    "type": "object",
    "required": [
      "q"
    ],
    "properties": {
      "q": {
        "type": "string"
      },
      "domains": {
        "type": "array",
        "items": {
          "enum": [
            "symbol",
            "metric",
            "skill",
            "strategy",
            "screener",
            "vfunc",
            "fn",
            "index",
            "industry",
            "memo",
            "workspace",
            "scripts"
          ]
        },
        "default": [
          "symbol",
          "metric",
          "strategy",
          "skill",
          "screener",
          "vfunc",
          "index",
          "industry"
        ]
      },
      "market": {
        "type": "string",
        "default": "cn"
      },
      "limit": {
        "type": "integer",
        "default": 20,
        "maximum": 50
      }
    }
  },
  "runtime": {
    "mode": "discover",
    "entry": "POST /v1/analysis/xs/discover"
  },
  "required_scopes": [
    "analysis:xs:discover"
  ],
  "context_deps": [],
  "outputs_schema": {
    "type": "object",
    "x-envelope": "http",
    "x-primary_path": "result.hits",
    "description": "Prefer data.result.hits; dual-read data.hits at top level.",
    "properties": {
      "result": {
        "type": "object",
        "properties": {
          "hits": {
            "type": "array"
          },
          "partial": {
            "type": "object"
          }
        }
      },
      "hits": {
        "type": "array",
        "description": "dual-read alias of result.hits"
      },
      "partial": {
        "type": "object"
      }
    }
  },
  "icon": "发",
  "category": "选股与发现",
  "author": "赢麻了官方",
  "official": true,
  "summary": "用自然语言找证券、指标、策略与投研能力，快速定位下一步该用什么。",
  "sample_prompts": [
    "贵州茅台代码是多少？",
    "白酒对应哪个行业？",
    "沪深300怎么写？",
    "历史股息该用哪个技能？",
    "公告减持对应哪个 notice 函数？",
    "screener.fetch 返回什么字段？"
  ],
  "expertise_tags": [
    "发现",
    "SkillHub",
    "技能路由",
    "discover",
    "vfunc",
    "returns_shape"
  ]
}
